# --- Multi-user auth (opt-in) ---
# Zero-login single-user by default. Enable steps, one-time schema migration,
# and the cloud hardening checklist live in README "Authentication & multi-user".
AUTH_ENABLED=false
BETTER_AUTH_SECRET=0mG_nZz4Q1pP5gS-tL6m-qVf74kYgU6b_l96l6z5-yQ
# Optional Google sign-in (email+password works without it; needs an OAuth client).
AUTH_GOOGLE_ENABLED=false
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
# Backend enforcement — pairs with AUTH_ENABLED=true. Copy the value from
# README "Authentication & multi-user" step 3 (its optional "openapi" block
# makes /docs auth-aware).
LANGGRAPH_AUTH=
REQUIRE_AUTH=false            # cloud: true → backend refuses to boot without LANGGRAPH_AUTH

# Human approval for the agent's shell tool — see README "Environment variables".
CAREER_AGENT_EXECUTE_APPROVAL=true
# Who may use the analytics agent when auth is on: comma-separated user ids or
# emails. Empty denies everyone; ignored when auth is off. See README.
ANALYTICS_AGENT_ALLOWED_USERS=

# --- Agent sandbox (execute tool) ---
# local = shell on the backend host (default). e2b = isolated microVM over the
# E2B API (self-hosted CubeSandbox or E2B Cloud) — see README "Environment
# variables" and deploy/cubesandbox/README.md for provisioning + template setup.
SANDBOX_PROVIDER=local
#SANDBOX_E2B_API_URL=http://your-cubesandbox-host:3000
#SANDBOX_E2B_API_KEY=e2b_000000 # gitleaks:allow
#SANDBOX_TEMPLATE=

# --- Object storage (binary artifacts: uploads + rendered PDFs) ---
# Local SeaweedFS presets work as-is; overview & cloud setup in README
# "Environment variables". AWS_* above is Bedrock-only.
OBJECT_STORE_LOCAL_PORT=8334
OBJECT_STORE_UI_LOCAL_PORT=8889
OBJECT_STORE_ENDPOINT=http://localhost:${OBJECT_STORE_LOCAL_PORT}
OBJECT_STORE_BUCKET=next-role-artifacts
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_ACCESS_KEY=dev-access-key
OBJECT_STORE_SECRET_KEY=dev-secret-key # gitleaks:allow
OBJECT_STORE_FORCE_PATH_STYLE=true

